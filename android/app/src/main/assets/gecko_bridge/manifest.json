{
  "manifest_version": 2,
  "name": "Tool TikTok Gecko bridge",
  "version": "1.0.0",
  "browser_specific_settings": {
    "gecko": { "id": "gecko-bridge@brisklane.com" }
  },
  "permissions": [
    "<all_urls>",
    "geckoViewAddons",
    "nativeMessaging",
    "nativeMessagingFromContent",
    "webRequest",
    "webRequestBlocking"
  ],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "match_about_blank": true,
    "all_frames": true,
    "run_at": "document_start",
    "js": ["content.js"]
  }]
}
